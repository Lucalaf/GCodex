{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Gcodex",
  "mainBinaryName": "gcodex",
  "version": "0.1.1",
  "identifier": "com.gcodex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GCodex",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Cross-platform CNC controller and G-code sender",
    "longDescription": "GCodex is a desktop CNC controller and G-code sender for Grbl 1.1+ machines, with a 3D toolpath and stock visualizer.",
    "category": "DeveloperTool",
    "linux": {
      "rpm": {
        "release": "1",
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "openssl-libs",
          "systemd-libs"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}